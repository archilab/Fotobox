# Server configuration. Copy to .env, which is read when the server starts from this folder.
# Variables already set in the shell take precedence over this file.
# Never put real credentials in this example file.

# Image provider. Only "mock" is implemented; any other value stops the server at startup.
PHOTOBOX_PROVIDER=mock

# Where portraits, generated strips and seed images are stored.
PHOTOBOX_STORAGE_DIR=./storage

# SQLite database location. Defaults to photobox.sqlite3 inside the storage folder.
# PHOTOBOX_DB_PATH=./storage/photobox.sqlite3

# Largest accepted upload in bytes.
PHOTOBOX_MAX_UPLOAD_BYTES=10000000

# Pool portrait retention in hours (1-720). An engineering default, not an approved privacy schedule.
PHOTOBOX_POOL_HOURS=24

# Seconds between automatic deletions of expired portraits and strips (1-86400).
PHOTOBOX_CLEANUP_INTERVAL_SECONDS=300

# Frames per strip: 3 or 4.
PHOTOBOX_NUM_FRAMES=4
