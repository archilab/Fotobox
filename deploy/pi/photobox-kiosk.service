# Runs the keyboard kiosk on the Pi's screen (tty1) in place of the login prompt (ADR-020).
# Install: see INSTALL.md. The setup menu writes the settings in /home/admin/.photobox-kiosk.env.
[Unit]
Description=Photo booth keyboard kiosk
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=admin
WorkingDirectory=/home/admin/photobox
# The console's default font is unreadably small on a 4K screen. "-" ignores a missing font; "+" runs it as root.
ExecStartPre=-+/usr/bin/setfont -C /dev/tty1 /usr/share/consolefonts/Uni3-TerminusBold32x16.psf.gz
# The browser screen, or the text kiosk if the browser cannot run (ADR-028). For the text kiosk only, run it directly.
ExecStart=/home/admin/photobox/deploy/pi/run-kiosk.sh --config /home/admin/.photobox-kiosk.env --token-file /home/admin/.photobox.token --pin-file /home/admin/.photobox-setup.json
# A login session on tty1, which is what lets Cage use the screen and keyboard.
PAMName=login
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
